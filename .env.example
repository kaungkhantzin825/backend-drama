APP_NAME="DramaLoop"
APP_ENV=local
APP_KEY=base64:ayrPyQpFBOle2kn60VMRo5OFOLLDZYdVjQM9IqGWB9g=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=drama_rewards
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# Cache store. Use "redis" in production for speed; "database" works with no
# extra services and is what local dev uses out of the box.
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis is used for caching, queues and rate limiting once the server is up.
# Start it with:  redis-server --port 6379
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dramaloop.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Google Sign-In (mobile) ──────────────────────────────────────────────────
# Client ID issued in Google Cloud Console → APIs & Services → Credentials.
# The Android client ID is also required for the Flutter client to call
# `POST /api/v1/auth/google` (it sends the ID token signed for that client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_IOS=

# ─── Admin panel ─────────────────────────────────────────────────────────────
# Separate credential set for the Inertia admin panel. Leave empty in local
# dev to fall back to the credentials below.
ADMIN_EMAIL=admin@dramaloop.test
ADMIN_PASSWORD=

# ─── Push notifications (FCM HTTP v1) ────────────────────────────────────────
# Optional. When FCM_ENABLED is false the app still records notifications in the
# in-app inbox; it simply does not push them. To enable, download a service
# account key from Firebase Console → Project settings → Service accounts and
# point FIREBASE_CREDENTIALS at its absolute path. Never commit that file.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
FCM_ANDROID_CHANNEL=dramaloop_default
